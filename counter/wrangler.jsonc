{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nohrikha-counter",
  "main": "worker.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "MAX_DAILY_VIEWS": "5000" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nohrikha-counter",
      "database_id": "87c07e76-4b7d-41e4-9c68-f0477df256c1"
    }
  ]
}
